    {
      "name": "示例：办公网 192.168.1.x",
      "remark": "改成自己环境的地址即可；网关写成 网关:跃点数 可指定优先级",
      "adapters": [
        {
          "adapter": "以太网",
          "enabled": true,
          "mode": "static",
          "ip": "192.168.1.88",
          "mask": "255.255.255.0",
          "gateways": ["192.168.1.1"],
          "dns": ["192.168.1.1", "114.114.114.114"],
          "dhcpDns": false,
          "routes": []
        }
      ]
    },
    {
      "name": "示例：双网关 + 附加路由",
      "remark": "演示多默认网关（冒号后为跃点数）与额外静态路由的写法",
      "adapters": [
        {
          "adapter": "以太网",
          "enabled": true,
          "mode": "static",
          "ip": "10.10.20.66",
          "mask": "255.255.255.0",
          "gateways": ["10.10.20.1:10", "10.10.30.1:20"],
          "dns": ["10.10.20.1"],
          "dhcpDns": false,
          "routes": ["172.16.0.0/12>10.10.20.254"]
        }
      ]
    }
  ]
