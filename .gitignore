# 本机实际配置（含内网 IP / 网关 / DNS，包含隐私信息，绝对不要提交）
profiles.json
applied-routes.json
profiles.bak-*.json

# 备份目录（含本机网络状态，可能含内网地址）
backups/

# 日志文件（可能包含本机网络信息）
NetSwitch.log
*.log

# 桌面快捷方式（本机生成）
*.lnk

# 系统与编辑器临时文件
.DS_Store
Thumbs.db
desktop.ini

# ── C# 版构建产物 ─────────────────────────────────────────────
# bin / obj 是编译与 NuGet 还原产物，体积大且可完整重建，绝不入仓
[Bb]in/
[Oo]bj/
*.user
*.suo
*.pdb
project.nuget.cache

# 发布目录：单文件 exe 约 64 MB，不入仓（用 build.bat 本地生成）
发布/
publish/

# 私有 .NET SDK（约 285 MB，供本地编译用，不入仓）
tools/

# 开发期临时产物（截图核对、可行性验证、并行开发的隔离副本）
_shot*/
_buffercheck/
_p1/
_p2test/
_feasibility/
